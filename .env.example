# AgriSage AI Environment Configuration
# Copy this file to .env and fill in your actual keys before running.
# NEVER commit .env to version control.

# --- LLM / AI Providers ---
# Google Gemini API key (for advisory_agent.py LLM synthesis)
GEMINI_API_KEY=

# Groq API key (alternative LLM provider)
GROQ_API_KEY=

# Sarvam AI API key (voice STT/TTS + multilingual translation)
SARVAM_API_KEY=

# Data.gov.in API key (district-wise crop production & mandi prices)
DATA_GOV_API_KEY=

# --- Database / Storage ---
# Supabase PostgreSQL connection
SUPABASE_URL=
SUPABASE_KEY=

# SQLAlchemy database URL (SQLite for local development)
DATABASE_URL=sqlite:///./agrisage.db

# --- External Services ---
# Open-Meteo (no key required - weather_agent.py)
# Sarvam AI voice endpoints (no key needed in URL, uses SARVAM_API_KEY)
SARVAM_STT_URL=https://api.sarvam.ai/v1/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/v1/text-to-speech

# --- Application Settings ---
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
